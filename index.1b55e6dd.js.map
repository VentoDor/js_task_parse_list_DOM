function sortList(lis) {
    var items = Array.from(lis.children);
    items = items.sort(function(a, b) {
        var s1 = Number(a.dataset.salary.replace(/[$,]/g, ""));
        var s2 = Number(b.dataset.salary.replace(/[$,]/g, ""));
        return s2 - s1;
    });
    items.forEach(function(el) {
        return lis.appendChild(el);
    });
}
function getEmployees(lists) {
    var items = Array.from(lists.children);
    var arr = [];
    items.forEach(function(el) {
        var obj = {};
        obj.name = el.textContent.trim();
        obj.position = el.dataset.position;
        obj.salary = el.dataset.salary;
        obj.age = el.dataset.age;
        arr.push(obj);
    });
    return arr;
}
